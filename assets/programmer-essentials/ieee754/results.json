{
  "environment": {
    "compiler": "GCC 13.1.1 20230614 (Red Hat 13.1.1-4)",
    "compiler_flags": [
      "-std=c++20",
      "-O2",
      "-ffp-contract=off",
      "-fno-fast-math"
    ],
    "architecture": "x86_64",
    "cpu_model": "AMD EPYC-Genoa Processor",
    "floating_point_environment": "FE_DFL_ENV: round-to-nearest ties-to-even, nontrapping exceptions"
  },
  "method": "BF16 values are simulated by software rounding binary32 bit patterns; outputs remain float objects. No hardware BF16 arithmetic is measured.",
  "measurements": {
    "rounding": "nearest, ties to even",
    "classification": [
      {
        "name": "positive zero",
        "bits": "0x00000000",
        "sign": 0,
        "exponent_field": 0,
        "fraction_field": 0,
        "category": "zero"
      },
      {
        "name": "negative zero",
        "bits": "0x80000000",
        "sign": 1,
        "exponent_field": 0,
        "fraction_field": 0,
        "category": "zero"
      },
      {
        "name": "minimum subnormal",
        "bits": "0x00000001",
        "sign": 0,
        "exponent_field": 0,
        "fraction_field": 1,
        "category": "subnormal"
      },
      {
        "name": "minimum normal",
        "bits": "0x00800000",
        "sign": 0,
        "exponent_field": 1,
        "fraction_field": 0,
        "category": "normal"
      },
      {
        "name": "one",
        "bits": "0x3f800000",
        "sign": 0,
        "exponent_field": 127,
        "fraction_field": 0,
        "category": "normal"
      },
      {
        "name": "one and a half",
        "bits": "0x3fc00000",
        "sign": 0,
        "exponent_field": 127,
        "fraction_field": 4194304,
        "category": "normal"
      },
      {
        "name": "maximum finite",
        "bits": "0x7f7fffff",
        "sign": 0,
        "exponent_field": 254,
        "fraction_field": 8388607,
        "category": "normal"
      },
      {
        "name": "positive infinity",
        "bits": "0x7f800000",
        "sign": 0,
        "exponent_field": 255,
        "fraction_field": 0,
        "category": "infinity"
      },
      {
        "name": "quiet NaN",
        "bits": "0x7fc00000",
        "sign": 0,
        "exponent_field": 255,
        "fraction_field": 4194304,
        "category": "nan"
      }
    ],
    "bf16_software_quantization": [
      {
        "input": 256,
        "rounded": 256
      },
      {
        "input": 257,
        "rounded": 256
      },
      {
        "input": 258,
        "rounded": 258
      },
      {
        "input": 259,
        "rounded": 260
      }
    ],
    "bf16_software_256_plus_1": 256,
    "fp32_2pow24_plus_1": 16777216,
    "zero_over_zero_is_nan": true,
    "one_over_zero_is_positive_infinity": true,
    "zero_times_infinity_is_nan": true,
    "infinity_minus_infinity_is_nan": true,
    "fmod_infinity_one_is_nan": true,
    "fmod_one_zero_is_nan": true,
    "nan_equals_nan": false,
    "nan_not_equals_nan": true,
    "integers_0_through_256_exact_in_bf16": true
  }
}
